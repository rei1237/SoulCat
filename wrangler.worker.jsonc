{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soulcat-service",
  "main": "server/worker-entry.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "unconfigured",
    "LLM_PROVIDER": "mock",
    "ALLOW_LIVE_LLM": "false"
  },
  "env": {
    "staging": {
      "name": "soulcat-service-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "LLM_COST_MODE": "test",
        "LLM_TEST_BUDGET_KRW": "1000",
        "LLM_DAILY_BUDGET_KRW": "1000",
        "LLM_TIMEOUT_MS": "60000",
        "LLM_MAX_RETRIES": "2",
        "LLM_MAX_INPUT_TOKENS": "32000",
        "LLM_MAX_OUTPUT_TOKENS": "8192",
        "APP_ENV": "staging",
        "PUBLIC_ORIGIN": "https://staging.code-destiny.com",
        "LLM_PROVIDER": "mock",
        "ALLOW_LIVE_LLM": "false"
      },
      "services": [
        {
          "binding": "AUTH_SERVICE",
          "service": "code-destiny-web-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "BOOK_QUEUE",
            "queue": "soulcat-book-staging"
          }
        ],
        "consumers": [
          {
            "queue": "soulcat-book-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 2,
            "dead_letter_queue": "soulcat-book-staging-dlq"
          }
        ]
      },
      "triggers": {
        "crons": [
          "*/2 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "soulcat-fortune-staging",
          "database_id": "e80d79b1-8f5e-4337-a713-b1b9d1a01f06",
          "migrations_dir": "server/db/migrations"
        }
      ],
      "routes": [
        {
          "pattern": "staging.code-destiny.com/yeongnyangi*",
          "zone_name": "code-destiny.com"
        },
        {
          "pattern": "staging.code-destiny.com/share/yeongnyangi/*",
          "zone_name": "code-destiny.com"
        },
        {
          "pattern": "staging.code-destiny.com/_soulcat",
          "zone_name": "code-destiny.com"
        },
        {
          "pattern": "staging.code-destiny.com/_soulcat/*",
          "zone_name": "code-destiny.com"
        },
        {
          "pattern": "staging.code-destiny.com/api/yeongnyangi/*",
          "zone_name": "code-destiny.com"
        }
      ]
    },
    "production": {
      "name": "soulcat-service-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "LLM_TIMEOUT_MS": "60000",
        "LLM_MAX_RETRIES": "2",
        "LLM_MAX_INPUT_TOKENS": "32000",
        "LLM_MAX_OUTPUT_TOKENS": "8192",
        "APP_ENV": "production",
        "PUBLIC_ORIGIN": "https://code-destiny.com",
        "LLM_PROVIDER": "mock",
        "ALLOW_LIVE_LLM": "false"
      },
      "services": [
        {
          "binding": "AUTH_SERVICE",
          "service": "code-destiny-web"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "BOOK_QUEUE",
            "queue": "soulcat-book-production"
          }
        ],
        "consumers": [
          {
            "queue": "soulcat-book-production",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 2,
            "dead_letter_queue": "soulcat-book-production-dlq"
          }
        ]
      },
      "triggers": {
        "crons": [
          "*/2 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "soulcat-fortune-production",
          "migrations_dir": "server/db/migrations"
        }
      ],
      "routes": [
        {
          "pattern": "code-destiny.com/yeongnyangi*",
          "zone_name": "code-destiny.com"
        },
        {
          "pattern": "code-destiny.com/share/yeongnyangi/*",
          "zone_name": "code-destiny.com"
        },
        {
          "pattern": "code-destiny.com/_soulcat",
          "zone_name": "code-destiny.com"
        },
        {
          "pattern": "code-destiny.com/_soulcat/*",
          "zone_name": "code-destiny.com"
        },
        {
          "pattern": "code-destiny.com/api/yeongnyangi/*",
          "zone_name": "code-destiny.com"
        }
      ]
    }
  }
}
