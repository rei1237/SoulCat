{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soulcat",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_ENV": "preview", "LLM_PROVIDER": "mock", "ALLOW_LIVE_LLM": "false" },
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "soulcat-fortune", "database_id": "172413ab-7ddf-4538-a7ec-8238b92efa35", "migrations_dir": "server/db/migrations" }],
  "env": {
    "preview": {
      "vars": { "APP_ENV": "preview", "LLM_PROVIDER": "mock", "ALLOW_LIVE_LLM": "false" },
      "d1_databases": [{ "binding": "DB", "database_name": "soulcat-fortune-staging", "database_id": "e80d79b1-8f5e-4337-a713-b1b9d1a01f06", "migrations_dir": "server/db/migrations" }]
    }
  }
}
